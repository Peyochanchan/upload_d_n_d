<%%= form_with model: @<%= singular_name %>, local: true do |f| %>
  <%% if @<%= singular_name %>.errors.any? %>
    <div class="error-messages">
      <h2><%%= pluralize(@<%= singular_name %>.errors.count, "erreur") %> :</h2>
      <ul>
        <%% @<%= singular_name %>.errors.full_messages.each do |message| %>
          <li><%%= message %></li>
        <%% end %>
      </ul>
    </div>
  <%% end %>

  <%# Vos autres champs de formulaire ici %>
  <%# Exemple: %>
  <%# <div class="field"> %>
  <%#   <%%= f.label :name %> %>
  <%#   <%%= f.text_field :name %> %>
  <%# </div> %>

  <div class="field">
    <%%= f.label :<%= attribute_name %> %>
    <%% if @<%= singular_name %>.persisted? %>
      <%# Record existant : upload direct %>
      <%%= upload_field :<%= attribute_name %>,
                       record: @<%= singular_name %>,
<% if options[:multiple] -%>
                       multiple: true,
<% end -%>
                       accepted_types: '<%= options[:content_type].map { |ct| ".#{ct.split('/').last}" }.join(',') %>',
                       max_size: <%= options[:max_size] %>.megabytes %>
    <%% else %>
      <%# Nouveau record : upload temporaire %>
      <%%= upload_field :<%= attribute_name %>,
<% if options[:multiple] -%>
                       multiple: true,
<% end -%>
                       accepted_types: '<%= options[:content_type].map { |ct| ".#{ct.split('/').last}" }.join(',') %>',
                       max_size: <%= options[:max_size] %>.megabytes %>
      <%%= hidden_field_tag :temp_upload_session_id, session.id.to_s %>
    <%% end %>
  </div>

  <div class="actions">
    <%%= f.submit %>
  </div>
<%% end %>
