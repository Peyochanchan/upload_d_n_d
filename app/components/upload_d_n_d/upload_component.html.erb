<div class="udnd-container"
     style="--udnd-accent-color: <%= main_color %>; --udnd-accent-rgb: <%= main_color_rgb %>;"
     data-controller="upload-d-n-d--uploads"
     data-upload-d-n-d--uploads-record-id-value="<%= record&.id %>"
     data-upload-d-n-d--uploads-record-gid-value="<%= record_gid %>"
     data-upload-d-n-d--uploads-attribute-name-value="<%= attribute_name %>"
     data-upload-d-n-d--uploads-attach-url-value="<%= attach_path %>"
     data-upload-d-n-d--uploads-max-size-value="<%= max_size %>"
     data-upload-d-n-d--uploads-accepted-types-value="<%= accepted_types %>"
     data-upload-d-n-d--uploads-mime-types-value="<%= accepted_mime_types %>"
     data-upload-d-n-d--uploads-field-ref-value="<%= field_ref %>"
     data-upload-d-n-d--uploads-multiple-value="<%= multiple %>"
     data-upload-d-n-d--uploads-i18n-value="<%= i18n_messages.to_json %>">

  <div class="udnd-dropzone"
       role="button"
       tabindex="0"
       aria-label="<%= t('upload_d_n_d.drag_and_drop') %>"
       data-action="dragover->upload-d-n-d--uploads#handleDragOver dragenter->upload-d-n-d--uploads#handleDragEnter dragleave->upload-d-n-d--uploads#handleDragLeave drop->upload-d-n-d--uploads#handleDrop">

    <input type="file"
           class="udnd-input-hidden"
           aria-label="<%= t('upload_d_n_d.drag_and_drop') %>"
           data-action="change->upload-d-n-d--uploads#previewFiles"
           accept="<%= accepted_types %>"
           <%= 'multiple' if multiple %>>

    <div class="udnd-dropzone-content">
      <div class="udnd-icon-wrapper">
        <svg class="udnd-icon udnd-icon-lg" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 13v8"/><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="m8 17 4-4 4 4"/></svg>
      </div>
      <p class="udnd-text-main"><%= t('upload_d_n_d.drag_and_drop') %></p>
      <p class="udnd-text-sub"><%= accepted_types %> (max. <%= number_to_human_size(max_size) %>)</p>
    </div>

    <div class="udnd-progress-container"
         role="progressbar"
         aria-valuenow="0"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-label="<%= t('upload_d_n_d.progress', default: 'Upload progress') %>">
      <div class="udnd-progress-bar" data-upload-d-n-d--uploads-target="progressBar"></div>
    </div>
  </div>

  <%# Record persisté : ses attachments. Sinon : les fichiers temporaires de la session,
      pour que la zone reste remplie après un rechargement de page. %>
  <% if record&.persisted? %>
    <%= render "upload_d_n_d/shared/files_list", record: record, attribute_name: attribute_name %>
  <% else %>
    <%= render "upload_d_n_d/shared/temp_files_list", files: files, attribute_name: attribute_name %>
  <% end %>
</div>
